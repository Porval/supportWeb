{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiatan:activity-model-recognition:1.0:provider-output",
  "type": "object",
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^candidate-(?:[1-9]|1[0-9]|20)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "enum": [
                    "activityName",
                    "platformCode",
                    "sourceActivityId",
                    "startAt",
                    "endAt",
                    "rulesText",
                    "brandBenefit",
                    "brandNameText"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "excerptId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,64}$"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "excerptId",
                      "quote"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 48,
                  "uniqueItems": true
                }
              },
              "required": [
                "field",
                "value",
                "refs"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "field": {
                        "const": "activityName"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "maxLength": 200
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "field": {
                        "const": "platformCode"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "maxLength": 200
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "field": {
                        "const": "sourceActivityId"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "maxLength": 200
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "field": {
                        "const": "startAt"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "maxLength": 200
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "field": {
                        "const": "endAt"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "maxLength": 200
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "field": {
                        "const": "rulesText"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "maxLength": 10000
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "field": {
                        "const": "brandBenefit"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "maxLength": 5000
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "field": {
                        "const": "brandNameText"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "maxLength": 200
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "field": {
                        "const": "platformCode"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "enum": [
                          null,
                          "jiatan",
                          "meituan",
                          "taobao_instant"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "value": {
                        "type": "string"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "refs": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "maxItems": 8
          }
        },
        "required": [
          "candidateId",
          "fields"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    }
  },
  "required": [
    "groups"
  ],
  "additionalProperties": false
}
